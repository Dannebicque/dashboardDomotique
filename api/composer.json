{
  "name": "dannebicque/dashboard-domotique-api",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/flex": "^2.6",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "require-dev": {
    "symfony/var-dumper": "8.1.*"
  },
  "config": {
    "allow-plugins": { "symfony/flex": true, "symfony/runtime": true },
    "sort-packages": true
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
  "extra": { "symfony": { "allow-contrib": false, "require": "8.1.*" } }
}
