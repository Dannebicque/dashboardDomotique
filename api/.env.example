# Copy the required values to api/.env.local. Never commit real credentials.

# Philips Hue
HUE_BRIDGE_URL=

# Weather
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=Europe/Paris

# Frontend
# Development: http://127.0.0.1:5173 — production: dashboard origin
FRONTEND_URL=http://127.0.0.1:5173

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Netatmo
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REDIRECT_URI=

# Somfy TaHoma local API
TAHOMA_BASE_URL=
